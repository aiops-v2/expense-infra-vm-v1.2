#!/bin/bash
# expense-monitoring (RHEL 9): Prometheus (:9090) with its DEFAULT configuration
# (the prometheus.yml shipped in the release: it scrapes only itself), plus
# node_exporter (:9100). Scrape jobs / EC2 service discovery are added by hand.
# Rendered by Terraform templatefile(); safe to re-run. A re-run never
# overwrites an existing /etc/prometheus/prometheus.yml.

mkdir -p /var/log/expense
exec > >(tee -a /var/log/expense/setup.log) 2>&1

VALIDATE() {
  if [ "$1" -ne 0 ]; then
    echo "$(date '+%F %T') $2 ... FAILURE"
    exit 1
  else
    echo "$(date '+%F %T') $2 ... SUCCESS"
  fi
}

echo "===== expense-monitoring setup started $(date) ====="

HOSTNAME_NEW="${hostname}"
NODE_EXPORTER_VERSION="${node_exporter_version}"
PROMETHEUS_VERSION="${prometheus_version}"

${monitoring_lib}

# ---- hostname (kept across reboots) -------------------------------------------
hostnamectl set-hostname "$HOSTNAME_NEW"
VALIDATE $? "set hostname $HOSTNAME_NEW"
grep -q " $HOSTNAME_NEW\$" /etc/hosts || echo "127.0.1.1 $HOSTNAME_NEW" >> /etc/hosts
VALIDATE $? "add hostname to /etc/hosts"
echo "preserve_hostname: true" > /etc/cloud/cloud.cfg.d/99-expense-hostname.cfg
VALIDATE $? "tell cloud-init to keep the hostname"

# ---- 2 GB swap (dd, not fallocate: swap files must not be sparse on XFS) -------
if ! swapon --show | grep -q /swapfile; then
  [ -f /swapfile ] || dd if=/dev/zero of=/swapfile bs=1M count=2048 status=none
  chmod 600 /swapfile && mkswap /swapfile && swapon /swapfile
  VALIDATE $? "create 2 GB swap"
  grep -q '^/swapfile' /etc/fstab || echo '/swapfile none swap defaults 0 0' >> /etc/fstab
else
  echo "swap already on, skipping"
fi

# ---- node_exporter (:9100) --------------------------------------------------------
INSTALL_NODE_EXPORTER "$NODE_EXPORTER_VERSION"

# ---- Prometheus (:9090) -------------------------------------------------------------
# No packages: Prometheus is a single static binary from the GitHub release.
PROMETHEUS_BASE="https://github.com/prometheus/prometheus/releases/download/v$PROMETHEUS_VERSION"
PROMETHEUS_TARBALL="prometheus-$PROMETHEUS_VERSION.linux-$ARCH.tar.gz"
INSTALL_RELEASE prometheus "$PROMETHEUS_VERSION" "$PROMETHEUS_BASE/$PROMETHEUS_TARBALL" "$PROMETHEUS_BASE/sha256sums.txt" 1

# prometheus / promtool on the PATH, for `promtool check config` etc.
ln -sfn /opt/prometheus/prometheus /usr/local/bin/prometheus &&
  ln -sfn /opt/prometheus/promtool /usr/local/bin/promtool
VALIDATE $? "link prometheus and promtool into /usr/local/bin"

# Config in /etc (edited by you), data in /var/lib (owned by prometheus).
# Both live outside /opt, so an upgrade (new /opt dir + relink) keeps them.
mkdir -p /etc/prometheus /var/lib/prometheus
chown prometheus:prometheus /var/lib/prometheus
VALIDATE $? "create /etc/prometheus and /var/lib/prometheus"
if [ -f /etc/prometheus/prometheus.yml ]; then
  echo "/etc/prometheus/prometheus.yml exists, keeping it"
else
  cp /opt/prometheus/prometheus.yml /etc/prometheus/prometheus.yml
  VALIDATE $? "install the default prometheus.yml"
fi
promtool check config /etc/prometheus/prometheus.yml
VALIDATE $? "promtool check config"

# ExecReload: after editing prometheus.yml, `sudo systemctl reload prometheus`
# re-reads it without a restart (SIGHUP). Check it first with promtool.
cat > /etc/systemd/system/prometheus.service <<'UNIT'
[Unit]
Description=Prometheus
After=network-online.target
Wants=network-online.target

[Service]
User=prometheus
Group=prometheus
ExecStart=/opt/prometheus/prometheus \
  --config.file=/etc/prometheus/prometheus.yml \
  --storage.tsdb.path=/var/lib/prometheus
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure

[Install]
WantedBy=multi-user.target
UNIT
VALIDATE $? "write prometheus.service"

OPEN_PORT 9090
START_SERVICE prometheus

# ---- check ---------------------------------------------------------------------------
READY=1
for i in $(seq 1 30); do
  if curl -fsS --max-time 3 http://127.0.0.1:9090/-/ready; then
    echo
    READY=0
    break
  fi
  sleep 2
done
VALIDATE $READY "GET :9090/-/ready"
WAIT_METRIC http://127.0.0.1:9090/metrics '^prometheus_build_info' "Prometheus serves its own metrics"

echo "===== EXPENSE SETUP COMPLETE $(date) ====="
